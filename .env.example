# Copy to .env.local for development. Never commit real values.

# Base URL of the Go API (including /api/v1) and its WebSocket host.
NEXT_PUBLIC_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Canonical public URL, used for SEO metadata, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://karena.stsebastiansportsacademy.com

# NextAuth (admin login). NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Use a long passphrase: the login is only rate-limited per server instance.
# If this is unset, nobody can log in.
ADMIN_PASSWORD=

# SERVER-SIDE ONLY (never prefix with NEXT_PUBLIC_). Lets /api/admin/bookings
# call the Go API's protected admin endpoint on behalf of a logged-in admin.
# Must equal ADMIN_API_KEY on the Go server (>= 32 chars: openssl rand -hex 32).
ADMIN_API_KEY=
